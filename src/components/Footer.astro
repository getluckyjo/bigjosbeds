---
import Icon from './Icon.astro';
import { business, whatsappHref } from '../lib/business';
import { fill } from '../lib/money';
import { canBuy } from '../lib/config';
import { navFor, policiesFor } from '../lib/site';
import { commerceFor, copyFor } from '../i18n/content';
import { htmlLang, type Locale } from '../i18n/locales';
import { policyPath } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = copyFor(locale);
const commerce = commerceFor(locale);
const t = ui(locale);

// The number is shown once (as the phone link) when WhatsApp uses the same number.
const digits = (n: string | null) => (n ?? '').replace(/\D/g, '');
const whatsappIsPhone = !!business.phone && digits(business.phone) === digits(business.whatsapp);
---

<footer class="bj-dark bj-section bj-footer">
  <div class="bj-container bj-footer__grid">
    <div class="bj-stack" style="--bj-stack-gap:16px">
      <img src="/logos/big-jos-bone.svg" width="190" height="64" alt="Big Jo’s Beds" loading="lazy" />
      <p>{copy.global.tagline}</p>
      <p class="bj-small">{copy.global.footer}</p>
    </div>
    <nav class="bj-footer__links" aria-label={t.footerNav}>
      {navFor(locale).map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="bj-footer__links">
      {
        policiesFor(locale).map((p) => (
          <a href={policyPath(locale, p.slug)} lang={p.textLocale === locale ? undefined : htmlLang[p.textLocale]}>{p.title}</a>
        ))
      }
      {business.email && <a href={`mailto:${business.email}`}>{business.email}</a>}
      {business.phone && <a href={`tel:${business.phone.replace(/\s+/g, '')}`}>{business.phone}</a>}
      {business.whatsapp && (
        <a class="bj-icon-text" href={whatsappHref(commerce.whatsapp.prefill)}>
          <Icon name="chat" />
          {whatsappIsPhone ? commerce.whatsapp.footerLinkSamePhone : fill(commerce.whatsapp.footerLink, { number: business.whatsapp })}
        </a>
      )}
      {canBuy() && <p class="bj-small bj-icon-text"><Icon name="secure" />{t.paymentsByPayFast}</p>}
    </div>
  </div>
</footer>
