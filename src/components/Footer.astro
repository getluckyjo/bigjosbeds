---
import copy from '../content/copy.json';
import { business } from '../lib/business';
import { canBuy } from '../lib/config';
import { nav, policies } from '../lib/site';
---

<footer class="bj-dark bj-section bj-footer">
  <div class="bj-container bj-footer__grid">
    <div class="bj-stack" style="--bj-stack-gap:16px">
      <img src="/logos/big-jos-bone.svg" width="190" height="72" alt="Big Jo’s Beds" loading="lazy" />
      <p>{copy.global.tagline}</p>
      <p class="bj-small">{copy.global.footer}</p>
    </div>
    <nav class="bj-footer__links" aria-label="Footer">
      {nav.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="bj-footer__links">
      {policies.map((p) => <a href={`/policies/${p.slug}`}>{p.title}</a>)}
      {business.email && <a href={`mailto:${business.email}`}>{business.email}</a>}
      {business.phone && <a href={`tel:${business.phone.replace(/\s+/g, '')}`}>{business.phone}</a>}
      {canBuy() && <p class="bj-small">Payments are processed by PayFast.</p>}
    </div>
  </div>
</footer>
