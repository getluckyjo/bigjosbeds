---
import Base from '../../layouts/Base.astro';
import ProductPicture from '../../components/ProductPicture.astro';
import copy from '../../content/copy.json';
import commerce from '../../content/commerce.json';
import { business } from '../../lib/business';
import { claims, defaultFinish, defaultItem, finishes, items, maxQuantity, productName } from '../../lib/catalogue';
import { canBuy, commerceMode } from '../../lib/config';
import { imageCaption, productionBody } from '../../lib/content';
import { formatZar, toPayFastAmount } from '../../lib/money';

const page = copy.productPage;
const buying = canBuy();
const initialFinish = finishes.find((f) => f.id === defaultFinish)!;
const imageSizes = '(min-width: 1100px) 56vw, (min-width: 768px) 50vw, 100vw';

const specs = [
  { label: 'Width × length', value: '160 × 210 cm' },
  { label: 'Approximate depth', value: '25 cm' },
  { label: 'Feel', value: 'Firm' },
  ...(claims.loadRating.publish ? [{ label: 'Rated for', value: `Up to ${claims.loadRating.kgPerPerson} kg per person` }] : []),
  { label: 'Made in', value: 'Cape Town' },
];

// Product structured data only once real prices are live (docs/04: no offer data before then).
const jsonLd =
  commerceMode() === 'live' && Astro.site
    ? {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: productName,
        description: page.intro,
        brand: { '@type': 'Brand', name: 'Big Jo’s Beds' },
        url: new URL(Astro.url.pathname, Astro.site).href,
        offers: items.map((item) => ({
          '@type': 'Offer',
          name: item.name,
          price: toPayFastAmount(item.priceCents),
          priceCurrency: 'ZAR',
          availability: 'https://schema.org/MadeToOrder',
        })),
      }
    : null;
---

<Base title={page.seo.title} description={page.seo.description}>
  {jsonLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <section class="bj-container bj-section bj-stack">
    <nav class="bj-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">The bed</span></nav>

    <div class="bj-grid bj-product-layout bj-config" data-bj-config>
      <div class="bj-stack" style="--bj-stack-gap:16px">
        {
          finishes.map((finish) => (
            <figure class="bj-figure" data-show-finish={finish.id}>
              <ProductPicture name={finish.image} alt={finish.alt} sizes={imageSizes} eager={finish.id === defaultFinish} />
            </figure>
          ))
        }
        {
          finishes.map((finish) => (
            <figure class="bj-figure bj-figure--detail" data-show-finish={finish.id}>
              <ProductPicture name={finish.detailImage} alt={finish.detailAlt} sizes={imageSizes} />
            </figure>
          ))
        }
        <p class="bj-small bj-muted">{imageCaption()}</p>
      </div>

      <div class="bj-stack">
        <h1>{page.title}</h1>
        <p>{page.intro}</p>

        {
          buying && (
            <div>
              <p class="bj-price">
                {items.map((item) => (
                  <span data-show-item={item.id}>{formatZar(item.priceCents)}</span>
                ))}
              </p>
              <p class="bj-price-note">
                {items.map((item) => (
                  <span data-show-item={item.id}>{item.name}. </span>
                ))}
                {business.vatRegistered && <>{commerce.product.vatIncluded} </>}
                {commerce.product.delivery}
              </p>
            </div>
          )
        }

        <form class="bj-stack" method="get" action="/checkout">
          <fieldset class="bj-fieldset">
            <legend>{page.finishLabel}</legend>
            <div class="bj-finishes">
              {
                finishes.map((finish) => (
                  <label class="bj-finish">
                    <input type="radio" name="finish" value={finish.id} data-label={finish.name} checked={finish.id === defaultFinish} />
                    <span class={`bj-finish__chip${finish.id === 'charcoal' ? ' bj-finish__chip--charcoal' : ''}`} aria-hidden="true" />
                    {finish.name}
                  </label>
                ))
              }
            </div>
          </fieldset>
          <p class="bj-small" aria-live="polite">Selected finish: <strong data-bj-finish-name>{initialFinish.name}</strong></p>

          {
            buying && (
              <>
                <fieldset class="bj-fieldset">
                  <legend>{commerce.product.itemLegend}</legend>
                  <div class="bj-options">
                    {items.map((item) => (
                      <label class="bj-option">
                        <input type="radio" name="item" value={item.id} checked={item.id === defaultItem} />
                        <span class="bj-option__name">{item.name}</span>
                        <span class="bj-option__price">{formatZar(item.priceCents)}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>

                <div class="bj-field">
                  <label for="qty">{commerce.product.quantityLabel}</label>
                  <select class="bj-input bj-qty" id="qty" name="qty">
                    {Array.from({ length: maxQuantity }, (_, i) => (
                      <option value={i + 1}>{i + 1}</option>
                    ))}
                  </select>
                </div>

                <div class="bj-stack" style="--bj-stack-gap:8px">
                  <h2 class="bj-eyebrow">{commerce.product.includedTitle}</h2>
                  {items.map((item) => (
                    <ul class="bj-list" data-show-item={item.id}>
                      {item.includes.map((line) => <li>{line}</li>)}
                    </ul>
                  ))}
                  <p class="bj-small bj-muted">{commerce.product.notIncluded}</p>
                </div>

                <div class="bj-buy">
                  <button class="bj-button" type="submit">{commerce.product.buyCta}</button>
                </div>
              </>
            )
          }
        </form>

        <dl class="bj-specs">
          {specs.map((spec) => <div><dt>{spec.label}</dt><dd>{spec.value}</dd></div>)}
        </dl>

        <div class="bj-row" style="gap:12px 28px">
          {
            buying ? (
              <a data-bj-enquiry-link href={`/contact?finish=${defaultFinish}`}>{commerce.product.askLink}</a>
            ) : (
              <a data-bj-enquiry-link class="bj-button" href={`/contact?finish=${defaultFinish}`}>{page.cta}</a>
            )
          }
          <a href="#dimensions">{page.secondaryCta}</a>
        </div>
      </div>
    </div>
  </section>

  <section id="dimensions" class="bj-container bj-section bj-grid">
    <h2>{page.dimensions.title}</h2>
    <div class="bj-stack">
      <p>{page.dimensions.body}</p>
      <p class="bj-small bj-muted">{page.dimensions.notes}</p>
    </div>
  </section>

  <section id="construction" class="bj-container bj-section bj-stack">
    <h2>{page.construction.title}</h2>
    <div class="bj-table-wrap">
      <table>
        <thead><tr><th scope="col">Layer</th><th scope="col">Thickness</th><th scope="col">Material</th></tr></thead>
        <tbody>
          {page.construction.layers.map((layer) => <tr><th scope="row">{layer.name}</th><td>{layer.size}</td><td>{layer.description}</td></tr>)}
        </tbody>
      </table>
    </div>
    <p>{page.construction.summary}</p>
  </section>

  <section class="bj-container bj-section bj-grid">
    <div class="bj-stack">
      <h2>{page.feel.title}</h2>
      <p>{page.feel.body}</p>
    </div>
    <div class="bj-stack">
      <h2>{page.base.title}</h2>
      <p>{page.base.body}</p>
    </div>
  </section>

  <div class="bj-ticking" aria-hidden="true"></div>

  <section class="bj-container bj-section bj-grid">
    <div class="bj-stack">
      <h2>{page.production.title}</h2>
      <p>{productionBody()}</p>
    </div>
    <div class="bj-stack">
      <h2>{page.enquiry.title}</h2>
      <p>{page.enquiry.body}</p>
      <div><a data-bj-enquiry-link class={buying ? 'bj-button bj-button--secondary' : 'bj-button'} href={`/contact?finish=${defaultFinish}`}>{page.enquiry.cta}</a></div>
    </div>
  </section>
</Base>
