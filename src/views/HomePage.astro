---
import Base from '../layouts/Base.astro';
import ProductPicture from '../components/ProductPicture.astro';
import FaqList from '../components/FaqList.astro';
import { Picture } from 'astro:assets';
import Icon from '../components/Icon.astro';
import { finishesFor, getItem, homeHeroFor } from '../lib/catalogue';
import { business, whatsappHref } from '../lib/business';
import { canBuy } from '../lib/config';
import { assurances, imageCaption } from '../lib/content';
import { founderPhoto, founderPhotoWidths } from '../lib/founder';
import { fill, formatZar } from '../lib/money';
import { commerceFor, copyFor } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import { path } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = copyFor(locale);
const commerce = commerceFor(locale);
const t = ui(locale);
const home = copy.home;
const homeHero = homeHeroFor(locale);
const finishes = finishesFor(locale);
const productPath = path(locale, 'product');
// The fit card answers "what size is it?" with the plan, so the questions beside it are the next ones people ask.
const homeFaqs = ['who', 'feel', 'linen'].map((id) => copy.faqPage.items.find((item) => item.id === id)!);
const sizeFact = home.facts[0];
const setPrice = formatZar(getItem('set')!.priceCents);
// Icons stand in for the deck's fact details (Width × length, Mattress feel, Made to order),
// which stay available to screen readers.
const factIcons = ['size', 'layers', 'cape-town'] as const;
---

<Base title={home.seo.title} description={home.seo.description} locale={locale}>
  <section class="bj-container bj-home-hero">
    <div class="bj-home-hero__intro bj-stack">
      <span class="bj-eyebrow">{home.hero.eyebrow}</span>
      <h1>{home.hero.title}</h1>
      <p class="bj-lead">{home.hero.body}</p>
    </div>
    <div class="bj-home-hero__actions bj-stack">
      <div class="bj-row">
        <a class="bj-button" href={home.hero.primaryCta.href}>{home.hero.primaryCta.label}</a>
        <a class="bj-button bj-button--secondary" href={home.hero.secondaryCta.href}>{home.hero.secondaryCta.label}</a>
      </div>
      <ul class="bj-facts" aria-label={t.quickFacts}>
        {
          home.facts.map((fact, i) => (
            <li>
              <Icon name={factIcons[i]} />
              <span><span class="bj-sr-only">{fact.detail}: </span>{fact.label}</span>
            </li>
          ))
        }
      </ul>
      {
        canBuy() && (
          <ul class="bj-facts" aria-label={t.buyingDetails}>
            <li><Icon name="price" />{fill(commerce.hero.priceFact, { price: setPrice })}</li>
            <li><Icon name="delivery" />{commerce.hero.deliveryFact}</li>
            {assurances(undefined, locale).map((a) => <li><Icon name={a.icon} />{a.short}</li>)}
          </ul>
        )
      }
    </div>
    <figure class="bj-home-hero__figure">
      <ProductPicture name={homeHero.image} alt={homeHero.alt} sizes="(min-width: 1360px) 1280px, 92vw" eager />
      <figcaption class="bj-small bj-muted">{imageCaption(locale)}</figcaption>
    </figure>
  </section>

  <section class="bj-container bj-section bj-grid">
    <h2>{home.introduction.title}</h2>
    <div class="bj-stack">
      {home.introduction.paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </section>

  <div class="bj-ticking" aria-hidden="true"></div>

  <section class="bj-container bj-section bj-stack" id="finishes">
    <h2>{home.finishes.title}</h2>
    <p class="bj-reading">{home.finishes.body}</p>
    <div class="bj-grid">
      {
        home.finishes.items.map((item) => {
          const finish = finishes.find((f) => f.id === item.id)!;
          return (
            <article class="bj-stack">
              <ProductPicture name={finish.image} alt={finish.alt} sizes="(min-width: 768px) 45vw, 100vw" class="bj-product-image" />
              <h3>{item.name}</h3>
              <p>{item.body}</p>
              <a class="bj-link-arrow" href={`${productPath}?finish=${item.id}`}>{item.cta}<Icon name="arrow-right" /></a>
            </article>
          );
        })
      }
    </div>
  </section>

  <section class="bj-container bj-section bj-grid">
    <h2>{home.construction.title}</h2>
    <div class="bj-stack">
      <p>{home.construction.body}</p>
      <a class="bj-link-arrow" href={`${productPath}#construction`}>{home.construction.cta}<Icon name="arrow-right" /></a>
    </div>
  </section>

  <section class="bj-green bj-section">
    <div class:list={['bj-container', founderPhoto ? 'bj-home-story' : 'bj-grid']}>
      <h2 class="bj-home-story__title">{home.story.title}</h2>
      {
        founderPhoto && (
          <figure class="bj-home-story__photo">
            <Picture
              src={founderPhoto}
              alt={t.founderPhotoAlt}
              widths={founderPhotoWidths}
              sizes="(min-width: 1024px) 40vw, calc(100vw - 40px)"
              formats={['avif', 'webp']}
              fallbackFormat="jpg"
              loading="lazy"
              decoding="async"
            />
          </figure>
        )
      }
      <div class="bj-stack bj-home-story__body">
        <blockquote class="bj-quote">
          <p>“{home.story.quote}”</p>
          <footer>{home.story.quoteBy}</footer>
        </blockquote>
        <p>{home.story.body}</p>
        <a class="bj-link-arrow" href={path(locale, 'story')}>{home.story.cta}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>

  <section class="bj-container bj-section bj-home-help">
    <div class="bj-home-help__faq bj-stack">
      <h2>{t.homeFaqTitle}</h2>
      <FaqList items={homeFaqs} />
      <a class="bj-link-arrow" href={path(locale, 'faqs')}>{t.allFaqs}<Icon name="arrow-right" /></a>
    </div>

    <div class="bj-fit" role="group" aria-labelledby="fit-title">
      <div class="bj-fit-plan" role="img" aria-label={`${sizeFact.detail}: ${sizeFact.label}`}>
        <span class="bj-fit-plan__dim bj-fit-plan__dim--width" aria-hidden="true"><span>160 cm</span></span>
        <span class="bj-fit-plan__bed" aria-hidden="true"><span></span><span></span></span>
        <span class="bj-fit-plan__dim bj-fit-plan__dim--length" aria-hidden="true"><span>210 cm</span></span>
      </div>
      <div class="bj-fit__body bj-stack" style="--bj-stack-gap:16px">
        <h2 id="fit-title" class="bj-h3">{home.closing.title}</h2>
        <p>{home.closing.body}</p>
        <div class="bj-fit__actions">
          <a class="bj-button" href={path(locale, 'contact')}>{home.closing.cta}</a>
          {business.whatsapp && <a class="bj-icon-text" href={whatsappHref(commerce.whatsapp.prefill)}><Icon name="chat" />{commerce.whatsapp.productLink}</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
