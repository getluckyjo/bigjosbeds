---
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { parseSelection, selectionQuery } from '../lib/catalogue';
import { fill } from '../lib/money';
import { commerceFor } from '../i18n/content';
import type { Locale } from '../i18n/locales';
import { path } from '../i18n/routes';
import { ui } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui(locale);
const c = commerceFor(locale).cancelled;
const params = Astro.url.searchParams;
const selection = parseSelection({ item: params.get('item'), finish: params.get('finish'), qty: params.get('qty') ?? '1' }, locale);
const retryHref = selection ? `${path(locale, 'checkout')}?${selectionQuery(selection)}` : path(locale, 'product');
const askHref = `${path(locale, 'contact')}?finish=${selection?.finish.id ?? 'unsure'}`;
---

<Base title={c.seoTitle} noindex locale={locale}>
  <section class="bj-container bj-section bj-stack bj-reading">
    <Icon name="info" class="bj-status-icon" />
    <h1>{c.title}</h1>
    <p class="bj-lead">{c.body}</p>
    {
      selection && (
        <p>{fill(t.cancelledSelection, { item: selection.item.checkoutName, finish: selection.finish.name, qty: String(selection.quantity) })}</p>
      )
    }
    <div class="bj-row">
      <a class="bj-button" href={retryHref}>{c.retry}</a>
      <a class="bj-button bj-button--secondary" href={askHref}>{c.ask}</a>
    </div>
  </section>
</Base>
