{
  "$schema": "Big Jos flat token contract v1; see docs/02-tokens.md",
  "version": "1.0.0",
  "color": {
    "bone": "#F4F0E7",
    "paper": "#FFFCF6",
    "clay": "#A3442F",
    "clay-hover": "#873724",
    "ink": "#292C27",
    "muted": "#66635B",
    "flax": "#CDBA9E",
    "charcoal": "#454541",
    "line": "#D9D1C4",
    "control-border": "#817A6E",
    "success": "#3F634C",
    "error": "#A12F2F"
  },
  "font": {
    "display": "DM Serif Display",
    "body": "DM Sans"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px"
  },
  "radius": {
    "control": "4px",
    "card": "8px",
    "pill": "999px"
  },
  "breakpoint": {
    "tablet": "768px",
    "desktop": "1100px"
  },
  "layout": {
    "container": "1280px",
    "reading": "680px",
    "gutter": "clamp(20px, 4vw, 64px)"
  },
  "type": {
    "display": "clamp(3rem, 6.8vw, 6.75rem)",
    "h1": "clamp(2.75rem, 5.3vw, 5.5rem)",
    "h2": "clamp(2rem, 3.7vw, 3.75rem)",
    "h3": "clamp(1.5rem, 2.2vw, 2rem)",
    "body": "1rem",
    "lead": "clamp(1.125rem, 1.7vw, 1.375rem)",
    "small": "0.875rem"
  },
  "motion": {
    "fast": "120ms",
    "standard": "200ms",
    "slow": "320ms",
    "ease": "cubic-bezier(0.2, 0.7, 0.2, 1)"
  }
}
