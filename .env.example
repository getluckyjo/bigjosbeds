# Copy to .env for local development. On Vercel, set these in Project → Settings → Environment Variables.

# enquiry | sandbox | live
#   enquiry  no online checkout; "Ask about this bed" only
#   sandbox  working checkout against the PayFast sandbox, with a "Test shop" banner (default)
#   live     real payments; the build fails until every launch input is supplied (scripts/check-launch.mjs)
COMMERCE_MODE=sandbox

# Public URL of the site, used for PayFast return/cancel/notify links. Leave empty locally.
PUBLIC_SITE_URL=

# PayFast. Leave empty in sandbox mode to use PayFast's public sandbox test account.
# Live: PayFast dashboard → Settings → Integration (merchant ID/key) and Security passphrase.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Supabase (server-side only; never expose the service-role key to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Local development without Supabase: keep orders in memory (lost on restart). Never in production.
ORDER_STORE=memory

# Resend email. Without a key, emails are logged instead of sent.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "Big Jo’s Beds <orders@bigjosbeds.co.za>"
EMAIL_FROM=
# Where new-order and enquiry alerts go.
OWNER_EMAIL=
